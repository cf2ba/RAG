# ============================================================
# 掌柜智库 环境变量模板
# 复制为 .env 并填入真实值；切勿将 .env 提交到 Git！
# ============================================================

# --- LLM 配置（阿里云百炼 DashScope / 兼容 OpenAI API） ---
OPENAI_API_KEY=your-dashscope-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL 的兼容别名（config.py 里 OPENAI_BASE_URL or OPENAI_API_BASE，二者填其一即可）
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.0
VL_MODEL=qwen3-vl-flash
ITEM_MODEL=qwen-flash

# --- MinerU PDF 解析 ---
MINERU_TOKEN=your-mineru-token-here

# --- MinIO 对象存储 ---
MINIO_ENDPOINT=192.168.100.88:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=rag-knowledge-base
MINIO_IMG_DIR=images

# --- Milvus 向量数据库 ---
MILVUS_URL=http://192.168.100.88:19530
# 默认（商品）集合
CHUNKS_COLLECTION=product_chunks
ITEM_NAME_COLLECTION=product_item_names
# 旅游集合
TRAVEL_CHUNKS_COLLECTION=travel_chunks
TRAVEL_ITEM_NAME_COLLECTION=travel_item_names
# 是否启用旅游集合（true/false）
USE_TRAVEL_COLLECTION=true

# --- MongoDB ---
MONGO_URL=mongodb://192.168.100.88:27017
MONGO_DB_NAME=rag_chat_history

# --- MCP 联网检索（百炼 WebSearch） ---
MCP_API_KEY=your-dashscope-api-key-here
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# --- qwen3-rerank 重排序 ---
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=your-dashscope-api-key-here

# --- BGE-M3 嵌入模型 ---
BGE_M3_PATH=C:/Users/your-username/.cache/modelscope/hub/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True